```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Python artifacts (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage
*.coverage

# Temporary files
*.tmp
*.temp
```